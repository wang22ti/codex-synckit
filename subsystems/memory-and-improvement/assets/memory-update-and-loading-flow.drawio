        </mxCell>
        <mxCell id="44" value="4. No eager preload&lt;br&gt;&lt;font style=&quot;font-weight: normal;&quot;&gt;Do not inject full project or&lt;br&gt;global memory contents.&lt;br&gt;Do not open raw artifacts&lt;br&gt;by default.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6d7;strokeColor=#5c4d3d;fontSize=14;fontStyle=1;spacingTop=10;" vertex="1" parent="40">
