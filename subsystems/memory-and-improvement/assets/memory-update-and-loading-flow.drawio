        <mxCell id="41" value="1. New thread&lt;br&gt;&lt;font style=&quot;font-weight: normal;&quot;&gt;Codex fires SessionStart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#3a2f25;fontSize=14;fontStyle=1;spacingTop=10;" vertex="1" parent="40">
