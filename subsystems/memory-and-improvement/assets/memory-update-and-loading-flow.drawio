        </mxCell>
        <mxCell id="42" value="2. activator.sh&lt;br&gt;&lt;font style=&quot;font-weight: normal;&quot;&gt;Injects locations, namespace&lt;br&gt;catalog, loading rules, and&lt;br&gt;the logging checklist only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ecd4;strokeColor=#305c3a;fontSize=14;fontStyle=1;spacingTop=10;" vertex="1" parent="40">
          <mxGeometry x="250" y="56" width="280" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="3. Default read order&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-weight: normal;&quot;&gt;INIT.md -&amp;gt; SUMMARY.md&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-weight: normal;&quot;&gt;then factual files,&lt;br&gt;REVIEW, raw history,&lt;br&gt;asset index, then&lt;br&gt;concrete asset files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6dfc6;strokeColor=#855d2a;fontSize=14;fontStyle=1;spacingTop=10;" vertex="1" parent="40">
